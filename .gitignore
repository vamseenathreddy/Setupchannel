.env
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/
data/
# The unanchored "data/" rule above matches a folder named "data" at ANY
# depth, not just the repo-root data/ (synced state) -- it silently
# swallowed ramana/data/ (the Ramana Maharshi TV CONTENT BANK, real
# committed content, not runtime state) the first time that folder was
# added, causing every real run to fail with FileNotFoundError until
# force-added back in. Un-ignore it explicitly so this can't happen
# again, here or for any future channel's own committed content bank.
!ramana/data/
!ramana/data/**
# Same bug, same fix, for every channel added under channels/<name>/data/ (Jesus Worship
# Waves, InfoShorts Telugu, Divine Mantra Sangam, Devotional Trance Beats, and any future
# static-content-bank channel) -- their content.csv files are real committed content, not
# runtime state, and must not be swallowed by the unanchored "data/" rule above.
!channels/*/data/
!channels/*/data/**
*.db
.venv/
venv/
*.egg-info/
.mypy_cache/

# OAuth / API credentials -- never commit real secrets to a public repo
client_secrets.json
client_secret_*.json
token.json
*.token.json

# Wrapper script logs -- not sensitive, just noisy/local
run_daily.log
run_daily_python_stdout.log
run_daily_shorts_stdout.log

# Source material (copyrighted book compilations) -- never commit to a public repo
source_material/
channels/jesus/assets/music/candidates/*.mp3
channels/jesus/assets/music/candidates/index.txt
channels/pulse_boosting/assets/music/candidates/*.mp3
channels/pulse_boosting/assets/music/candidates/index.txt
channels/trance_beats/assets/music/candidates/*.mp3
channels/trance_beats/assets/music/candidates/index.txt

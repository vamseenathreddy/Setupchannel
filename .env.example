# Copy this file to .env and fill in real values. Never commit .env.

# --- Paths (defaults are fine for local dev) ---
MAHANAVI_IMAGES_ROOT=./Images
MAHANAVI_ASSETS_DIR=./assets
MAHANAVI_OUTPUT_DIR=./data/generated
MAHANAVI_DATABASE_PATH=./data/mahanavi.db
MAHANAVI_LOG_DIR=./data/logs

# --- Timezone (used for "today" everywhere: Panchang, posting windows) ---
MAHANAVI_TIMEZONE=Asia/Kolkata

# --- Panchang provider: "dummy" | "api" | "scraper" | "prokerala" ---
MAHANAVI_PANCHANG_PROVIDER=dummy
MAHANAVI_PANCHANG_API_BASE_URL=
MAHANAVI_PANCHANG_API_KEY=
MAHANAVI_PANCHANG_LATITUDE=17.3850
MAHANAVI_PANCHANG_LONGITUDE=78.4867

# Prokerala Astrology API (https://api.prokerala.com/) -- forever-free
# tier. A second client id/secret pair is optional, used as an automatic
# fallback if the first account's quota is exhausted for the day.
MAHANAVI_PROKERALA_CLIENT_ID=
MAHANAVI_PROKERALA_CLIENT_SECRET=
MAHANAVI_PROKERALA_CLIENT_ID_2=
MAHANAVI_PROKERALA_CLIENT_SECRET_2=

# --- Alert Shorts (Rahu Kalam / Shubha Ghadiyalu) ---
MAHANAVI_ALERT_SHORT_DURATION_SECONDS=10.0
# Icons and background music have real committed defaults under assets/ --
# only set these if you want to override them.
MAHANAVI_ALERT_ICON_LAKSHMI_PATH=
MAHANAVI_ALERT_ICON_GANESHA_PATH=
MAHANAVI_ALERT_ICON_KUBERA_PATH=
MAHANAVI_ALERT_SHORT_MUSIC_PATH=

# --- Sarvam AI Telugu voiceover (long-form Puranam videos) ---
MAHANAVI_SARVAM_API_KEY=
MAHANAVI_SARVAM_VOICE=priya
MAHANAVI_SARVAM_PACE=0.92
MAHANAVI_SARVAM_TEMPERATURE=0.75
MAHANAVI_SARVAM_SPEECH_SAMPLE_RATE=24000

# --- fal.ai (AI-generated Purana scene visuals) ---
MAHANAVI_FAL_API_KEY=

# --- YouTube (official Data API v3 Shorts uploader) ---
MAHANAVI_YOUTUBE_CLIENT_SECRETS_FILE=
MAHANAVI_YOUTUBE_TOKEN_FILE=./data/youtube_token.json

# --- Retry behaviour (every network call) ---
MAHANAVI_MAX_RETRIES=3
MAHANAVI_RETRY_BACKOFF_SECONDS=5
